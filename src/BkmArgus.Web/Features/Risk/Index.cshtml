@page
@model RiskModel
@attribute [Authorize]
@using Solum.Web.Components
@*
    Risk gezgini. Solum ilkelleri: <solum-field> · .solum-card · SolumTable ·
    solum-badge · _SolumEmpty (plan: 05, Dalga 1).

    EN BÜYÜK KAZANÇ — ÜÇ FORM BİRE İNDİ. Eski ekran aynı süzgeç durumunu
    üç ayrı GET formunda ~30 gizli input olarak tekrarlıyordu (kenar çubuğu,
    araç çubuğu, önceki/sonraki). Birinde eksik kalan alan süzgeci SESSİZCE
    sıfırlıyordu — örneğin sayfa değiştirince arama kaybolabilirdi.
    Artık tek form + RiskView.RouteData() tek üretim yeri.

    KALDIRILANLAR: 4 Tailwind kart kabı · 8 kolonlu elle tablo · AYNI VERİNİN
    MOBİL KOPYASI · 5 sınıf-üretici Razor fonksiyonu · ~30 gizli input.

    ÇOKLU SEÇİM: mekan/tip onay kutusu grupları elle yazılı — <solum-field>'de
    çoklu seçim türü yok (Solum'a bildirilecek). Alan görünümü solum-* ile.
*@
@{
    ViewData["Title"] = "Risk Gezgini";
    ViewData["Subtitle"] = "Süzgeçli risk listesi ve hızlı aksiyon";

    IReadOnlyList<SelectOption> siralamaSecenekleri = Model.OrderOptions
        .Select(o => new SelectOption(o.Value, o.Label)).ToList();

    IReadOnlyList<SelectOption> yonSecenekleri =
    [
        new("DESC", "Azalan"),
        new("ASC", "Artan")
    ];

    IReadOnlyList<SelectOption> sayfaBoyutuSecenekleri = Model.PageSizeOptions
        .Select(s => new SelectOption(s.ToString(), $"Sayfada {s}")).ToList();
}

<div class="argus-split">
    <div>
        <section class="solum-card">
            <div class="solum-card-head">
                <div>
                    <h3 class="solum-card-title">Risk listesi</h3>
                    <div class="solum-card-sub">
                        @Model.Rows.Count satır · sayfa @Model.PageIndex
                        @if (Model.Rows.Count == Model.PageSize)
                        {
                            <text>· sayfa dolu, devamı olabilir</text>
                        }
                    </div>
                </div>
                <div class="solum-row-side">
                    @* Dış aktarım aynı süzgeç durumunu taşır — durum tek yerden üretiliyor. *@
                    <a class="solum-btn" asp-page="/Risk/Index" asp-page-handler="Export"
                       asp-all-route-data="RiskView.RouteData(Model)">Excel indir</a>
                </div>
            </div>

            @Html.SolumTable(RiskView.Table(Model.Rows))

            @* Sayfalama: gizli input yığını yerine rota verisi. Sınırda düğme
               yerine METİN gösterilir — tıklanamaz düğme kullanıcıyı yanıltır
               (screen-ux-standard §7: tıklanamaz aksiyonu gösterme). *@
            <div class="argus-pager">
                @if (Model.HasPrevPage)
                {
                    <a class="solum-btn" asp-page="/Risk/Index"
                       asp-all-route-data="RiskView.RouteData(Model, Model.PageIndex - 1)">← Önceki</a>
                }
                else
                {
                    <span class="solum-hint">İlk sayfa</span>
                }

                <span class="solum-hint">Sayfa @Model.PageIndex</span>

                @if (Model.HasNextPage)
                {
                    <a class="solum-btn" asp-page="/Risk/Index"
                       asp-all-route-data="RiskView.RouteData(Model, Model.PageIndex + 1)">Sonraki →</a>
                }
                else
                {
                    <span class="solum-hint">Son sayfa</span>
                }
            </div>
        </section>

        @if (Model.Rows.Count > 0)
        {
            <section class="solum-card">
                <div class="solum-card-head">
                    <div>
                        <h3 class="solum-card-title">Bayrak dağılımı</h3>
                        <div class="solum-card-sub">Bu sayfadaki kayıtların risk bayrakları — satıra tıklayın</div>
                    </div>
                </div>
                @foreach (var satir in Model.Rows.Take(10))
                {
                    <a class="solum-row argus-row-link"
                       href="/Urun/Index?id=@satir.Id&mekanId=@satir.MekanId">
                        <span class="solum-row-main">
                            <span class="solum-row-label">@satir.Urun</span>
                            <span class="solum-row-desc">
                                @satir.Mekan · @satir.UrunKod · @satir.SonHareketGun gün önce
                            </span>
                        </span>
                        <span class="solum-row-side">
                            @foreach (var bayrak in satir.Flags)
                            {
                                <span class="@RiskView.FlagBadgeClass(bayrak)">@RiskView.FlagText(bayrak)</span>
                            }
                            <span class="@RiskView.StockBadgeClass(satir.StokVar)">@satir.StokAdet.ToString("N0")</span>
                            <span class="@RiskView.ScoreBadgeClass(satir.Skor)">@satir.Skor</span>
                        </span>
                    </a>
                }
            </section>
        }
    </div>

    <section class="solum-card">
        <div class="solum-card-head">
            <div>
                <h3 class="solum-card-title">Süzgeçler</h3>
                <div class="solum-card-sub">URL ile paylaşılabilir durum</div>
            </div>
        </div>

        @* TEK form: filtre + arama + sıralama + sayfa boyutu. Sayfa daima 1'e
           döner — süzgeç değişince eski sayfada kalmak boş liste gösterirdi. *@
        <form method="get">
            <input type="hidden" name="sayfa" value="1" />

            <solum-field asp-for="Search" label="Arama" placeholder="Ürün, kod ya da mekan…" />

            <div class="argus-filter">
                <solum-field asp-for="MinSkor" label="Min skor" />
                <solum-field asp-for="MaxSkor" label="Maks skor" />
            </div>

            <div class="argus-filter">
                <solum-field asp-for="KesimBas" label="Kesim başlangıç" />
                <solum-field asp-for="KesimBit" label="Kesim bitiş" />
            </div>

            <solum-field asp-for="OrderBy" label="Sıralama" kind="FieldKind.Select"
                         options="siralamaSecenekleri" />
            <solum-field asp-for="OrderDir" label="Yön" kind="FieldKind.Select"
                         options="yonSecenekleri" />
            <solum-field asp-for="PageSize" label="Sayfa boyutu" kind="FieldKind.Select"
                         options="sayfaBoyutuSecenekleri" />

            @* Çoklu seçim: <solum-field>'de bu tür yok, elle yazıldı ama
               görünüm solum-* sınıflarından geliyor. *@
            <fieldset class="argus-checkgroup">
                <legend class="solum-label">Mekan</legend>
                @foreach (var mekan in Model.MekanOptions)
                {
                    var secili = Model.SelectedMekan.Any(m =>
                        string.Equals(m, mekan.Value, StringComparison.OrdinalIgnoreCase));
                    <label class="argus-checkitem">
                        <input class="solum-checkbox" type="checkbox" name="mekan"
                               value="@mekan.Value" checked="@secili" />
                        <span>@mekan.Label</span>
                    </label>
                }
            </fieldset>

            <fieldset class="argus-checkgroup">
                <legend class="solum-label">Risk tipi</legend>
                @foreach (var tip in Model.TipOptions)
                {
                    var secili = Model.SelectedTip.Any(t =>
                        string.Equals(t, tip, StringComparison.OrdinalIgnoreCase));
                    <label class="argus-checkitem">
                        <input class="solum-checkbox" type="checkbox" name="tip"
                               value="@tip" checked="@secili" />
                        <span>@RiskView.FlagText(tip)</span>
                    </label>
                }
            </fieldset>

            <div class="argus-filter-actions">
                <button class="solum-btn solum-btn-primary" type="submit">Uygula</button>
                <a class="solum-btn" asp-page="/Risk/Index">Temizle</a>
            </div>
        </form>
    </section>
</div>
