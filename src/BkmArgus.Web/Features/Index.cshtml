@page "/"
@model IndexModel
@attribute [Authorize]
@using Solum.Web.Components
@inject IKpiRenderer KpiRenderer
@*
    Genel Bakış. Solum ilkelleri: KpiCard/RenderGrid · .solum-card · .solum-row ·
    _SolumEmpty (plan: 05, Dalga 1). Elle yazılmış 3 Tailwind kart kabı ve
    ToneClass() sınıf-üretici fonksiyonu kaldırıldı — ton artık SolumTone.

    screen-ux-standard §6: boş durum yalnız "kayıt yok" demez, ne yapılacağını
    söyler. Solum'un _SolumEmpty parçasında aksiyon yuvası yok, o yüzden ipucu
    metniyle yönlendiriliyor.
*@
@{
    ViewData["Title"] = "Genel Bakış";
    ViewData["Subtitle"] = "Sabah özeti ve hızlı aksiyonlar";

    // SP'den gelen ton kodu -> Solum ton sabiti. Tek eşleme yeri.
    var kartlar = Model.StatusCards.Select(k => new KpiCard
    {
        Label = k.Baslik,
        Value = k.Deger,
        Hint = k.Not,
        // BILINMEYEN TON NOTR (denetim bulgusu 5.7): alt dal `_ => Bad` idi,
        // yani SP'nin ton kolonu bosalirsa ya da kolon adi degisirse BUTUN
        // kartlar kirmizi oluyordu — veri kaybi alarm kiligina giriyordu.
        // SP'nin uretebildigi "tone-alert" de artik acikca esli
        // (sql/32_sps_remaining_english.sql:126), tesadufe birakilmiyor.
        Tone = k.Tone switch
        {
            "tone-good" => SolumTone.Good,
            "tone-warn" => SolumTone.Warn,
            "tone-bad" or "tone-alert" => SolumTone.Bad,
            _ => SolumTone.Neutral
        }
    }).ToList();
}

@* KPI bos durumu: eskiden RenderGrid kosulsuz cagriliyordu ve SP 0 satir
   dondurdugunde sayfanin tepesi SESSIZCE bosaliyordu (bulgu 5.7). *@
@if (kartlar.Count == 0)
{
    <partial name="/Pages/Shared/_SolumEmpty.cshtml"
             model="@(("Günlük özet üretilemedi.", (string?)"Gecelik ETL çalışmamış olabilir — Tanımlar > sağlık kontrolüne bakın."))" />
}
else
{
    @KpiRenderer.RenderGrid(kartlar)
}

<div class="argus-split-equal">
    <section class="solum-card">
        <div class="solum-card-head">
            <div>
                <h3 class="solum-card-title">Hızlı aksiyonlar</h3>
                <div class="solum-card-sub">Sık kullanılan ekranlar</div>
            </div>
        </div>
        <a class="solum-row argus-row-link" asp-page="/Dashboard/Index">
            <span class="solum-row-main"><span class="solum-row-label">Risk panosu</span></span>
            <span class="solum-row-side"><span class="solum-row-desc">Son 24 saat</span></span>
        </a>
        <a class="solum-row argus-row-link" asp-page="/Risk/Index">
            <span class="solum-row-main"><span class="solum-row-label">Risk gezgini</span></span>
            <span class="solum-row-side"><span class="solum-row-desc">Filtreli liste</span></span>
        </a>
        <a class="solum-row argus-row-link" asp-page="/Dof/Index">
            <span class="solum-row-main"><span class="solum-row-label">DÖF panosu</span></span>
            <span class="solum-row-side"><span class="solum-row-desc">Açık aksiyonlar</span></span>
        </a>
        <a class="solum-row argus-row-link" asp-page="/Ref/Index">
            <span class="solum-row-main"><span class="solum-row-label">Tanımlar</span></span>
            <span class="solum-row-side"><span class="solum-row-desc">Parametreler</span></span>
        </a>
    </section>

    <section class="solum-card">
        <div class="solum-card-head">
            <div>
                <h3 class="solum-card-title">Bugünün notları</h3>
                <div class="solum-card-sub">Takip edilmesi gerekenler</div>
            </div>
        </div>
        @if (Model.QuickNotes.Count == 0)
        {
            <partial name="/Pages/Shared/_SolumEmpty.cshtml"
                     model="@(("Takip notu yok.", (string?)"Risk gezgininden bir kayda bakarak başlayabilirsiniz."))" />
        }
        else
        {
            @foreach (var not in Model.QuickNotes)
            {
                <div class="solum-row">
                    <div class="solum-row-main">
                        <div class="solum-row-label">@not</div>
                    </div>
                </div>
            }
        }
    </section>
</div>
