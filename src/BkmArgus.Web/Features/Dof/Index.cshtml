@page
@model BkmArgus.Web.Features.Dof.IndexModel
@attribute [Authorize]
@using Solum.Web.Components
@using BkmArgus.Web.Features.Dof
@inject IKpiRenderer KpiRenderer
@{
    ViewData["Title"] = "DÖF Yönetimi";
    ViewData["Subtitle"] = "Pano akışı ve SLA takibi";
}

@*
    KPI bandi ve baslik Solum ilkellerinde; pano asagida (plan: 05, Dalga 1).
    Sinif-uretici dort Razor fonksiyonu DofView.cs'e tasindi.
*@
@{
    var kpi = Model.Kpi;
    var dofKartlari = new List<KpiCard>
    {
        new() { Label = "Toplam DÖF", Value = (kpi?.TotalCount ?? 0).ToString() },
        new()
        {
            Label = "Açık bulgu",
            Value = ((kpi?.OpenCount ?? 0) + (kpi?.InProgressCount ?? 0)).ToString(),
            Hint = "Açık + devam eden"
        },
        new()
        {
            Label = "SLA geciken",
            Value = (kpi?.OverdueCount ?? 0).ToString(),
            // Is kurali: geciken tek bulgu bile kotudur — sifirsa iyi.
            Tone = (kpi?.OverdueCount ?? 0) > 0 ? KpiTone.Bad : KpiTone.Good
        },
        new()
        {
            Label = "Ort. çözüm",
            Value = kpi?.AvgResolutionDays.ToString("0.#") ?? "—",
            Hint = "gün"
        }
    };
}

@KpiRenderer.RenderGrid(dofKartlari)

<section class="solum-card">
    <div class="solum-card-head">
        <div>
            <h3 class="solum-card-title">Aksiyon panosu</h3>
            <div class="solum-card-sub">Bulguları duruma göre takip et — kartı sürükleyerek durum değiştir</div>
        </div>
        <div class="solum-row-side">
            <a class="solum-btn solum-btn-primary" asp-page="Create">Yeni DÖF</a>
        </div>
    </div>
</section>

@*
    PANO. Mekanizma wwwroot/js/argus-board.js'te (surukleme + KLAVYE + DOM
    tasima); politika burada: hangi kolonlar, hangi durum kodu, hangi adres.
    Uc olculmus kusur bu gecise kadar duruyordu ve kapandi:
      1. bes satir ici olay isleyicisi -> addEventListener (CSP)
      2. klavye yolu YOKTU -> Alt+Sol/Sag (screen-ux-standard §10)
      3. basaridan sonra location.reload() -> DOM dugumu tasiniyor
    Kanban'in Solum'a girmesi kullanici istegi; Solum "Tier 3, kullanici karari"
    dedi ve "sen yaz, devralirsak ilk gercek kullanim senin kodun olur" onerdi.
*@
<section class="solum-card">
    <div class="argus-board-hint">
        Kartı sürükleyip bırakarak durum değiştirin. Fare kullanmadan:
        karta odaklanın (Tab) ve <strong>Alt + ← / →</strong> ile komşu kolona taşıyın.
    </div>

    <div class="argus-board" data-argus-board data-argus-drop-url="/api/dof/transition">
        @{
            // POLITIKA: kolon kumesi ve makine karsiliklari. Durum kodlari SP
            // sozlesmesinden gelir (dof.sp_Finding_Transition mesruiyeti dogrular).
            (string Kod, string Etiket, IEnumerable<BkmArgus.Web.Features.Dof.IndexModel.FindingRow> Kayitlar)[] kolonlar =
            [
                ("DRAFT", "Taslak", Model.Draft),
                ("OPEN", "Açık", Model.Open),
                ("IN_PROGRESS", "Devam ediyor", Model.InProgress),
                ("PENDING_VALIDATION", "Onay bekliyor", Model.PendingValidation),
                ("CLOSED", "Kapandı", Model.Closed)
            ];
        }

        @foreach (var (kod, etiket, kayitlar) in kolonlar)
        {
            var liste = kayitlar.ToList();
            <div class="argus-board-column" data-argus-column="@kod" aria-label="@etiket kolonu">
                <div class="argus-board-head">
                    <span class="argus-board-title">@etiket</span>
                    <span class="argus-board-count" data-argus-count>@liste.Count</span>
                </div>

                <div class="argus-board-list" data-argus-list>
                    @foreach (var kart in liste)
                    {
                        <a class="argus-board-card @DofView.RiskToneClass(kart.RiskLabel)"
                           asp-page="Detail" asp-route-id="@kart.DofId"
                           draggable="true" data-argus-card="@kart.DofId"
                           aria-label="@kart.Title, @kart.RiskLabel risk">
                            <span class="argus-board-card-top">
                                <span class="argus-board-card-title">@kart.Title</span>
                                <span class="@DofView.RiskBadgeClass(kart.RiskLabel)">@kart.RiskLabel</span>
                            </span>
                            @if (kart.FindingSignature is not null)
                            {
                                <span class="argus-board-card-sig">@kart.FindingSignature</span>
                            }
                            <span class="argus-board-card-meta">
                                <span>@(kart.AssignedTo ?? "—")</span>
                                @if (kart.SlaDueDate.HasValue)
                                {
                                    <span class="@DofView.SlaBadgeClass(kart.SlaDaysLeft)">@DofView.SlaText(kart.SlaDaysLeft)</span>
                                }
                            </span>
                        </a>
                    }
                    @* Bos kolon sessiz kalmaz; JS sayaci gunceller ve bunu gizler/gosterir. *@
                    <div class="solum-empty" data-argus-empty hidden="@(liste.Count > 0)">Bulgu yok</div>
                </div>
            </div>
        }
    </div>
</section>

@* Bildirim seridi: aria-live ile ekran okuyucuya da duyurulur. *@
<div id="argusToast" class="argus-toast" role="status" aria-live="polite" hidden></div>

@section Scripts {
    <script src="~/js/argus-board.js" asp-append-version="true"></script>
}
