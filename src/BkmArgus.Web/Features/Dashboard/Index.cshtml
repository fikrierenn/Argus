@page
@model DashboardModel
@attribute [Authorize]
@using Solum.Web.Components
@inject IKpiRenderer KpiRenderer
@*
    Dashboard. Gorunum ilkelleri Solum'dan: .solum-card / .solum-row / .solum-kpi /
    SolumTable / _SolumEmpty (plan: 04, Faz 3). Elle yazilmis 7 sinif-uretici
    fonksiyon ve 24 kart kabi kaldirildi; sunum haritasi DashboardView.cs'te.

    Yerel kalan tek ilkel: sekme seridi (.argus-tabs) — tek kullanim oldugu icin
    Solum'un uc-urun esigine takiliyor, bilerek pakete alinmadi.
*@
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Subtitle"] = "Sabah kahvesi ekranı";

    var trendDelta = DashboardView.TrendDelta(Model.TrendSerisi);
}

<nav class="argus-tabs" aria-label="Pano sekmeleri">
    <a class="argus-tabs-item @(Model.Tab == "risk" ? "argus-tabs-item--active" : "")"
       asp-page="/Dashboard/Index" asp-route-tab="risk">ERP Risk</a>
    <a class="argus-tabs-item @(Model.Tab == "audit" ? "argus-tabs-item--active" : "")"
       asp-page="/Dashboard/Index" asp-route-tab="audit">Saha Denetim</a>
    <a class="argus-tabs-item @(Model.Tab == "ai" ? "argus-tabs-item--active" : "")"
       asp-page="/Dashboard/Index" asp-route-tab="ai">AI</a>
</nav>

@if (Model.Tab == "risk")
{
    @KpiRenderer.RenderGrid(DashboardView.RiskKpis(Model))

    <div class="argus-split">
        <section class="solum-card">
            <div class="solum-card-head">
                <div>
                    <h3 class="solum-card-title">Risk trendi</h3>
                    <div class="solum-card-sub">Son 30 gün ortalama skor</div>
                </div>
                @if (trendDelta is not null)
                {
                    @* Ok hareketten, renk YARGIDAN gelir: risk dususu iyidir
                       (KpiPolarity.LowerIsBetter), yani asagi ok yesil olabilir. *@
                    var yargi = trendDelta.Judge();
                    <div class="solum-row-side">
                        <span class="solum-kpi-delta solum-kpi-@(yargi.ToString().ToLowerInvariant())-judge">
                            <span aria-hidden="true">@DashboardView.MovementGlyph(trendDelta.Movement)</span>
                            @trendDelta.Text
                            <span class="solum-sr-only">@DashboardView.DeltaScreenReaderText(trendDelta)</span>
                            <span class="solum-kpi-hint">@trendDelta.Hint</span>
                        </span>
                    </div>
                }
            </div>
            @* Renk CSS'ten gelir (.solum-spark -> currentColor / --solum-accent);
               eski surumdeki iki ciplak hex bu sayede kaldirildi. *@
            <svg class="solum-spark" viewBox="0 0 400 120" preserveAspectRatio="none" role="img"
                 aria-label="Son 30 günün ortalama risk skoru eğrisi">
                <line class="solum-spark-base" x1="0" y1="100" x2="400" y2="100" />
                <polyline points="@Model.TrendPoints" />
            </svg>
        </section>

        <section class="solum-card">
            <div class="solum-card-head">
                <h3 class="solum-card-title">Sağlık kontrolleri</h3>
            </div>
            @if (Model.HealthChecks.Count == 0)
            {
                <partial name="/Pages/Shared/_SolumEmpty.cshtml" model="@(("Sağlık kaydı yok.", (string?)"Job çalıştıktan sonra dolar."))" />
            }
            else
            {
                @foreach (var satir in Model.HealthChecks)
                {
                    <div class="solum-row">
                        <div class="solum-row-main">
                            <div class="solum-row-label">@satir.Kod</div>
                            <div class="solum-row-desc">@satir.Not</div>
                        </div>
                        <div class="solum-row-side">
                            <span class="@DashboardView.BadgeClass(satir.Durum)">@satir.Durum</span>
                        </div>
                    </div>
                }
            }
        </section>
    </div>

    <section class="solum-card">
        <div class="solum-card-head">
            <div>
                <h3 class="solum-card-title">En yüksek riskli 10 ürün</h3>
                <div class="solum-card-sub">Mağaza bazlı inceleme listesi — satıra tıklayın</div>
            </div>
            <div class="solum-row-side">
                <a class="solum-btn" asp-page="/Risk/Index">Risk gezginine git</a>
            </div>
        </div>
        @Html.SolumTable(DashboardView.RiskTable(Model.RiskPano))
    </section>

    <div class="argus-split-equal">
        <section class="solum-card">
            <div class="solum-card-head">
                <div>
                    <h3 class="solum-card-title">DÖF akışı</h3>
                    <div class="solum-card-sub">Açık aksiyonlar ve SLA</div>
                </div>
                <div class="solum-row-side">
                    <a class="solum-btn solum-btn-primary" asp-page="/Dof/Index">DÖF panosu</a>
                </div>
            </div>
            @if (Model.DofList.Count == 0)
            {
                <partial name="/Pages/Shared/_SolumEmpty.cshtml" model="@(("Açık DÖF yok.", (string?)null))" />
            }
            else
            {
                @foreach (var oge in Model.DofList)
                {
                    <div class="solum-row">
                        <div class="solum-row-main">
                            <div class="solum-row-label">@oge.Title</div>
                            <div class="solum-row-desc">Sorumlu: @oge.Sorumlu · SLA: @oge.SLA</div>
                        </div>
                        <div class="solum-row-side">
                            <span class="@DashboardView.BadgeClass(oge.Status)">@oge.Status</span>
                        </div>
                    </div>
                }
            }
        </section>

        <section class="solum-card">
            <div class="solum-card-head">
                <div>
                    <h3 class="solum-card-title">Tanımlar özeti</h3>
                    <div class="solum-card-sub">İşlem kalitesini besleyen parametreler</div>
                </div>
                <div class="solum-row-side">
                    <a class="solum-btn" asp-page="/Ref/Index">Tanımlara git</a>
                </div>
            </div>
            @foreach (var satir in Model.RefNotes)
            {
                <div class="solum-row">
                    <div class="solum-row-main">
                        <div class="solum-row-label">@satir.Baslik</div>
                        <div class="solum-row-desc">@satir.Not</div>
                    </div>
                    <div class="solum-row-side">
                        <span class="solum-badge">@satir.Deger</span>
                    </div>
                </div>
            }
        </section>
    </div>
}

@if (Model.Tab == "audit")
{
    @* Alti esit agirlikli olcum: 4+2 kirilmasi "ilk dort onemli" izlenimi verir,
       o yuzden izgara 6 kolona ayarlanir (Solum --solum-kpi-cols degiskeni). *@
    <div class="argus-kpi-6">
        @KpiRenderer.RenderGrid(DashboardView.AuditKpis(Model))
    </div>

    <section class="solum-card">
        <div class="solum-card-head">
            <div>
                <h3 class="solum-card-title">Son denetimler</h3>
                <div class="solum-card-sub">En son yapılan 5 saha denetimi — satıra tıklayın</div>
            </div>
            <div class="solum-row-side">
                <a class="solum-btn" asp-page="/Audit/Index">Tüm denetimler</a>
            </div>
        </div>
        @Html.SolumTable(DashboardView.RecentAuditsTable(Model.RecentAudits))
    </section>

    <section class="solum-card">
        <div class="solum-card-head">
            <div>
                <h3 class="solum-card-title">En riskli bulgular</h3>
                <div class="solum-card-sub">En çok başarısız olan denetim maddeleri</div>
            </div>
        </div>
        @Html.SolumTable(DashboardView.TopFindingsTable(Model.TopRiskFindings))
    </section>

    <section class="solum-card">
        <div class="solum-card-head">
            <div>
                <h3 class="solum-card-title">Mağaza skorları</h3>
                <div class="solum-card-sub">Lokasyon bazlı denetim performansı</div>
            </div>
        </div>
        @Html.SolumTable(DashboardView.LocationScoresTable(Model.LocationScores))
    </section>
}

@if (Model.Tab == "ai")
{
    @KpiRenderer.RenderGrid(DashboardView.AiKpis(Model))

    <section class="solum-card">
        <div class="solum-card-head">
            <div>
                <h3 class="solum-card-title">Proaktif öneriler</h3>
                <div class="solum-card-sub">AI tarafından tespit edilen aktif öneriler</div>
            </div>
            <div class="solum-row-side">
                <a class="solum-btn" asp-page="/Ai/Index" asp-route-tab="insights">Tümünü gör</a>
            </div>
        </div>
        @if (Model.ProactiveInsights.Count == 0)
        {
            <partial name="/Pages/Shared/_SolumEmpty.cshtml" model="@(("Aktif öneri bulunamadı.", (string?)"AI işleri çalıştıkça öneriler burada birikir."))" />
        }
        else
        {
            @foreach (var oneri in Model.ProactiveInsights)
            {
                var varlikTipi = (string)(oneri.EntityType ?? "");
                var varlikId = (int?)oneri.EntityId;
                var varlikAd = (string)(oneri.EntityName ?? "");
                <div class="solum-row">
                    <div class="solum-row-main">
                        <div class="solum-row-label">
                            <span class="@DashboardView.BadgeClass((string)(oneri.Severity ?? ""))">@(oneri.Severity ?? "-")</span>
                            @(oneri.Title ?? "-")
                        </div>
                        <div class="solum-row-desc">
                            @if (!string.IsNullOrWhiteSpace(varlikAd))
                            {
                                <span>@varlikTipi: @varlikAd · </span>
                            }
                            @(oneri.Description ?? "")
                        </div>
                    </div>
                    <div class="solum-row-side">
                        @if (varlikTipi == "MEKAN" && varlikId.HasValue)
                        {
                            <a class="solum-btn" href="/Risk?mekan=@varlikId">Ürünleri gör</a>
                        }
                        <a class="solum-btn solum-btn-primary" asp-page="/Dof/Index">Aksiyona al</a>
                    </div>
                </div>
            }
        }
    </section>

    <section class="solum-card">
        <div class="solum-card-head">
            <div>
                <h3 class="solum-card-title">Son skill çalışmaları</h3>
                <div class="solum-card-sub">AI skill çalışma geçmişi</div>
            </div>
            <div class="solum-row-side">
                <a class="solum-btn" asp-page="/Ai/Index" asp-route-tab="skills">Tümünü gör</a>
            </div>
        </div>
        @if (Model.AiSkillHistory.Count == 0)
        {
            <partial name="/Pages/Shared/_SolumEmpty.cshtml" model="@(("Kayıt bulunamadı.", (string?)null))" />
        }
        else
        {
            @* SP cikisi dynamic oldugu icin SolumTable (generic, tipli) kullanilmiyor;
               satir ilkeli tipsiz veriyle de calisir. *@
            @foreach (var satir in Model.AiSkillHistory)
            {
                var baslangic = (DateTime?)satir.StartedAt;
                <div class="solum-row">
                    <div class="solum-row-main">
                        <div class="solum-row-label">@(satir.SkillName ?? "-")</div>
                        <div class="solum-row-desc">
                            @(satir.SkillVersion ?? "") ·
                            @(baslangic?.ToString("dd.MM.yyyy HH:mm") ?? "-") ·
                            @(satir.DurationMs != null ? $"{satir.DurationMs} ms" : "-")
                        </div>
                    </div>
                    <div class="solum-row-side">
                        <span class="@DashboardView.BadgeClass((string)(satir.Status ?? ""))">@(satir.Status ?? "-")</span>
                    </div>
                </div>
            }
        }
    </section>
}
