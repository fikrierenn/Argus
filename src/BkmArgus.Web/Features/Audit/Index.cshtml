@page
@model BkmArgus.Web.Features.Audit.IndexModel
@attribute [Authorize]
@using Solum.Web.Components
@*
    Saha denetim listesi. Solum ilkelleri: <solum-field> (filtre alanlari) ·
    .solum-card · .solum-row · solum-badge · _SolumEmpty (plan: 05, Dalga 1).

    KALDIRILANLAR: 5 Tailwind kart kabi · 6 kolonlu elle yazilmis tablo · AYNI
    VERININ IKINCI KOPYASI (mobil kart listesi — masaustu tablo + mobil kart iki
    ayri isaretlemeydi, tek .solum-row listesi ikisini birden karsiliyor) ·
    4 sinif-uretici Razor fonksiyonu · satir ici onclick confirm (CSP).

    NEDEN TABLO DEGIL LISTE: her satirda Duzenle/Detay/Sil aksiyonlari var ve
    Sil bir POST formu. Solum'un TableModel'inde aksiyon hucresi sozlesmesi YOK
    (.solum-actions CSS'i var ama doldurma yolu yok) — Solum'a bulgu olarak
    bildirildi. Liste ilkeli aksiyonu tasiyabiliyor.
*@
@{
    ViewData["Title"] = "Saha Denetim";
    ViewData["Subtitle"] = "Denetim listesi ve yönetimi";

    @* Mantiksal deger secenekleri KUCUK harf — HTML makine bicimi bu.
       Kisa gecmis: ilk yazdigim kucuk harf Solum'un korumasindan HATA aldi
       ("deger 'False' ama seceneklerin hicbiri bu degeri tasimiyor"), gecici
       olarak "True"/"False" yazildi; Solum uretimi duzeltti (MachineValue
       bool'u her turde kucuk harfe normalize ediyor, commit 9d76486) ve dogru
       hale donuldu. Artik "True" yazmak HATA verir — makine bicimi tek. *@
    IReadOnlyList<SelectOption> durumSecenekleri =
    [
        new("true", "Kesinleştirildi"),
        new("false", "Taslak")
    ];
}

<section class="solum-card">
    <div class="solum-card-head">
        <div>
            <h3 class="solum-card-title">Denetim listesi</h3>
            <div class="solum-card-sub">
                @Model.Audits.Count kayıt@(Model.Kirpildi ? " (sınıra dayandı)" : "")
            </div>
        </div>
        <div class="solum-row-side">
            <a class="solum-btn solum-btn-primary" asp-page="/Audit/Create">Yeni denetim</a>
        </div>
    </div>

    @* SESSIZ KIRPMA (denetim bulgusu 5.5): SP en yeni @IndexModel.Limit kaydi doner,
       sayfalama yok. Baslik bunu "N kayit" diye TOPLAM gibi gosteriyordu;
       ceyrek raporu eksik denetimle yazilabiliyordu. *@
    @if (Model.Kirpildi)
    {
        <div class="solum-alert solum-alert-warn" role="status">
            En yeni @IndexModel.Limit denetim gösteriliyor — daha eskiler listede olmayabilir.
            Süzgeci daraltın (tarih aralığı ya da mekan).
        </div>
    }

    @* Filtre GET formu — alanlar Solum'un <solum-field>'i ile, kap bizde
       (argus-filter). Solum "kap sende, alanlar bizde" dedi; tasima geldiginde
       degisen yalniz kap olur. *@
    <form class="argus-filter" method="get">
        <solum-field asp-for="Search" label="Mağaza adı" placeholder="Ara…" />
        @* Tarih niyeti MODELDE: [DataType(DataType.Date)] (Index.cshtml.cs).
           Boylece kind her cagri yerinde tekrarlanmiyor — Solum onerisi. *@
        <solum-field asp-for="StartDate" label="Başlangıç" />
        <solum-field asp-for="EndDate" label="Bitiş" />
        <solum-field asp-for="IsFinalized" label="Durum" kind="FieldKind.Select"
                     options="durumSecenekleri" empty-option-text="Tümü" />
        <div class="argus-filter-actions">
            <button class="solum-btn solum-btn-primary" type="submit">Filtrele</button>
            <a class="solum-btn" asp-page="/Audit/Index">Temizle</a>
        </div>
    </form>
</section>

<section class="solum-card">
    @if (Model.Audits.Count == 0)
    {
        <partial name="/Pages/Shared/_SolumEmpty.cshtml"
                 model="@(("Denetim bulunamadı.", (string?)"Filtreyi genişletin ya da \"Yeni denetim\" ile ilk kaydı oluşturun."))" />
    }
    else
    {
        @foreach (var satir in Model.Audits)
        {
            var yuzde = AuditView.ScorePercent(satir.PassedItems, satir.TotalItems);
            <div class="solum-row">
                <div class="solum-row-main">
                    <div class="solum-row-label">@satir.LocationName</div>
                    <div class="solum-row-desc">
                        @(satir.ReportNo ?? "—") · @satir.LocationType ·
                        @satir.AuditDate.ToString("dd.MM.yyyy") ·
                        @satir.PassedItems/@satir.TotalItems madde
                    </div>
                </div>
                <div class="solum-row-side">
                    <span class="@AuditView.ScoreBadgeClass(yuzde)">%@yuzde</span>
                    <span class="@AuditView.StatusBadgeClass(satir.IsFinalized)">@AuditView.StatusText(satir.IsFinalized)</span>
                    <a class="solum-btn" asp-page="/Audit/Detail" asp-route-id="@satir.Id">Detay</a>
                    <a class="solum-btn" asp-page="/Audit/Edit" asp-route-id="@satir.Id">Düzenle</a>
                    @if (!satir.IsFinalized)
                    {
                        @* Yikici islem: onay ZORUNLU (screen-ux-standard §5).
                           Onceden satir ici onclick="return confirm(...)" vardi;
                           CSP icin data-* + olay devrine cevrildi. *@
                        <form method="post" asp-page-handler="Delete" class="argus-inline-form">
                            <input type="hidden" name="id" value="@satir.Id" />
                            <button class="solum-btn solum-btn-danger" type="submit"
                                    @* CASCADE KAPSAMI onay metninde yaziyor: audit.AuditResults ve
                                       ondan da AuditResultPhotos ON DELETE CASCADE ile gider
                                       (sql/21_sps_audit.sql:268). sql-conventions.md §7 "UI'da acik
                                       uyari zorunlu" diyor; eski metin yalniz "geri alinamaz" diyordu
                                       ve kullanici 45 maddeli bir denetimi bos sanip silebiliyordu. *@
                                    data-argus-confirm="@satir.LocationName denetimi silinecek. @satir.TotalItems madde sonucu ve bağlı fotoğraflar da SİLİNECEK. Bu işlem geri alınamaz. Devam edilsin mi?">
                                Sil
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    }
</section>
