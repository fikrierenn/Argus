@page
@model BkmArgus.Web.Features.Audit.ItemsModel
@attribute [Authorize(Policy = Policies.AdminOnly)]
@using Solum.Web.Components
@*
    Master denetim maddesi katalogu. Solum ilkelleri: <solum-field> ·
    .solum-card · .solum-row · <solum-errors> · _SolumEmpty (plan: 08).

    NEDEN BU EKRAN GEC TASINDI: plan 05 Dalga 1'de atlanmis, Dalga 3'e
    (form agirlikli) birakilmisti cunku Solum'da asp-for koprusu yoktu.
    2026-09-23'te olculdu: SolumFieldTagHelper.For (ModelExpression) ve
    <solum-errors> geldi, engel kalkti.

    KALDIRILANLAR: 2 sinif-uretici Razor fonksiyonu (RiskBadge, Truncate) ·
    ~14 Tailwind kart/kap sinifi · elle yazilmis 6 kolonlu tablo ·
    2 satir ici oninput olay isleyicisi (CSP borcu) · masaustu-sabit
    iki kolonlu izgara.

    NEDEN TABLO DEGIL .solum-row LISTESI: her satirda Duzenle + Pasife al
    aksiyonu var ve ikincisi bir POST formu. Solum'un TableModel'inde
    aksiyon hucresi sozlesmesi YOK (Audit/Index.cshtml'de ayni gerekce).
*@
@{
    ViewData["Title"] = "Denetim Maddeleri";
    ViewData["Subtitle"] = "Master madde katalogu";

    var duzenleniyor = Model.EditId.HasValue;
    var formBaslik = duzenleniyor ? "Madde düzenle" : "Yeni madde";

    IReadOnlyList<SelectOption> grupSecenekleri = Model.Groups
        .Select(g => new SelectOption(g, g)).ToList();

    IReadOnlyList<SelectOption> durumSecenekleri =
    [
        new("true", "Etkin"),
        new("false", "Pasif")
    ];

    // Bulgu tipi: DB kolonu char(1). Duzenlenen kayitta taninmayan bir kod
    // varsa listeye o da eklenir, yoksa Solum'un koruması ekrani kirar.
    IReadOnlyList<SelectOption> bulguTipiSecenekleri =
        AuditView.FindingTypeOptions(Model.Input.FindingType);

    // Suzgec panelinin rozeti ve ozeti icin: listeyi DARALTAN secimler.
    var aktifSuzgecler = new List<string>();
    if (!string.IsNullOrWhiteSpace(Model.Group)) aktifSuzgecler.Add($"Grup: {Model.Group}");
    if (Model.Aktif.HasValue) aktifSuzgecler.Add(Model.Aktif.Value ? "Yalnız etkin" : "Yalnız pasif");
}

<section class="solum-card">
    <div class="solum-card-head">
        <div>
            <h3 class="solum-card-title">Madde listesi</h3>
            <div class="solum-card-sub">
                @Model.Items.Count kayıt · katalog değişikliği gelecekteki denetimleri etkiler
            </div>
        </div>
    </div>

    @* Katlanir suzgec — Risk/Audit ekranlarinda kurulan kalip (plan 07 Faz 4).
       Gerekce Risk/Index.cshtml'de yazili. *@
    <details class="argus-filter-panel" data-argus-filter open>
        <summary class="argus-filter-summary">
            <span class="argus-filter-summary-metin">
                <span class="solum-card-title">Süzgeçler</span>
                <span class="solum-card-sub">
                    @(aktifSuzgecler.Count > 0
                        ? string.Join(" · ", aktifSuzgecler)
                        : "Ölçüt yok — tüm maddeler listeleniyor")
                </span>
            </span>
            @if (aktifSuzgecler.Count > 0)
            {
                <span class="@ArgusBadge.Class(SolumTone.Neutral)">@aktifSuzgecler.Count etkin</span>
            }
        </summary>

        <form class="argus-filter" method="get">
            <solum-field asp-for="Group" label="Grup" kind="FieldKind.Select"
                         options="grupSecenekleri" empty-option-text="Tümü" />
            <solum-field asp-for="Aktif" label="Durum" kind="FieldKind.Select"
                         options="durumSecenekleri" empty-option-text="Tümü" />
            <div class="argus-filter-actions">
                <button class="solum-btn solum-btn-primary" type="submit">Filtrele</button>
                <a class="solum-btn" asp-page="/Audit/Items">Temizle</a>
            </div>
        </form>
    </details>
</section>

<div class="argus-split">
    <section class="solum-card">
        @if (Model.Items.Count == 0)
        {
            <partial name="/Pages/Shared/_SolumEmpty.cshtml"
                     model="@(("Madde bulunamadı.", (string?)"Süzgeci genişletin ya da sağdaki formdan ilk maddeyi ekleyin."))" />
        }
        else
        {
            @foreach (var satir in Model.Items)
            {
                <div class="solum-row">
                    <div class="solum-row-main">
                        <div class="solum-row-label">@satir.ItemText</div>
                        <div class="solum-row-desc">
                            #@satir.SortOrder · @(satir.AuditGroup ?? "—") · @(satir.Area ?? "—") ·
                            @AuditView.FindingTypeText(satir.FindingType)
                        </div>
                    </div>
                    <div class="solum-row-side">
                        @* Skorun nasil olustugu rozette YAZIYOR: kullanici 4x5=20'yi
                           gorunce hangi alani degistirecegini bilir. Yalniz "20"
                           gostermek onu forma girip aramaya zorlardi. *@
                        <span class="@AuditView.ItemRiskBadgeClass(satir.RiskScore)">
                            @satir.Probability × @satir.Impact = @satir.RiskScore
                        </span>
                        @if (!satir.IsActive)
                        {
                            <span class="@ArgusBadge.Class(SolumTone.Warn)">Pasif</span>
                        }
                        <a class="solum-btn" asp-page="/Audit/Items"
                           asp-route-EditId="@satir.Id" asp-route-Group="@Model.Group"
                           asp-route-Aktif="@Model.Aktif">Düzenle</a>

                        @* Pasife alma SILME DEGIL: silinen maddenin gecmis denetim
                           sonuclari sahipsiz kalir. Bu yuzden onay metni de
                           "silinecek" demez — ne olacagini dogru anlatir. *@
                        <form method="post" asp-page-handler="SetActive" class="argus-inline-form">
                            <input type="hidden" name="itemId" value="@satir.Id" />
                            <input type="hidden" name="aktif" value="@((!satir.IsActive).ToString().ToLowerInvariant())" />
                            <button class="solum-btn @(satir.IsActive ? "solum-btn-danger" : "")" type="submit"
                                    data-argus-confirm="@(satir.IsActive
                                        ? $"\"{satir.ItemText}\" maddesi pasife alınacak. Yeni açılan denetimlere artık eklenmeyecek; geçmiş denetim sonuçları olduğu gibi kalacak. Devam edilsin mi?"
                                        : $"\"{satir.ItemText}\" maddesi yeniden etkinleştirilecek ve yeni denetimlere eklenmeye başlayacak. Devam edilsin mi?")">
                                @(satir.IsActive ? "Pasife al" : "Etkinleştir")
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
    </section>

    <section class="solum-card">
        <div class="solum-card-head">
            <div>
                <h3 class="solum-card-title">@formBaslik</h3>
                <div class="solum-card-sub">
                    @(duzenleniyor ? $"Madde #{Model.EditId} düzenleniyor" : "Katalog gelecekteki denetimlere kopyalanır")
                </div>
            </div>
        </div>

        @* Alan hatalari: Solum'un ModelState koprusu. Eskiden hicbir
           dogrulama yoktu — bos madde metni sessizce kaydediliyordu. *@
        <solum-errors />

        <form method="post"
              asp-page-handler="@(duzenleniyor ? "Update" : "Create")"
              asp-route-itemId="@Model.EditId">

            <solum-field asp-for="Input.AuditGroup" label="Denetim grubu" placeholder="Örn: Genel Görünüm" />

            <div class="argus-filter">
                <solum-field asp-for="Input.Area" label="Alan" placeholder="Örn: Kasa" />
                <solum-field asp-for="Input.RiskType" label="Risk tipi" placeholder="Örn: Operasyonel" />
            </div>

            <solum-field asp-for="Input.ItemText" label="Madde metni" kind="FieldKind.MultilineText"
                         placeholder="Denetim maddesi açıklaması…" />

            <div class="argus-filter">
                <solum-field asp-for="Input.SortOrder" label="Sıra no" />
                <solum-field asp-for="Input.FindingType" label="Bulgu tipi" kind="FieldKind.Select"
                             options="bulguTipiSecenekleri" empty-option-text="Seçiniz" />
            </div>

            <div class="argus-filter">
                <solum-field asp-for="Input.Probability" label="Olasılık (1-5)" />
                <solum-field asp-for="Input.Impact" label="Etki (1-5)" />
            </div>

            @* Risk onizlemesi. Skoru JS HESAPLAMAZ, yalnizca GOSTERIR — asil
               deger DB'de persisted computed kolondan gelir. Buradaki sayi
               bir tahmin degil, ayni carpimin ekrandaki yansimasi.
               Sunucu tarafi baslangic degeri basiyor ki JS yuklenmese de
               dogru gorunsun. *@
            <div class="argus-risk-onizleme">
                <span class="solum-card-sub">Risk skoru</span>
                @* ESIK VE SINIFLAR data-* ILE SUNUCUDAN GELIYOR: JS'in icine
                   "15" ya da "solum-badge-bad" yazmak esigi ikinci bir yere
                   kopyalamak olurdu ve biri degisince otekini kimse
                   guncellemezdi. Eski ekranda tam bu vardi — JS icinde
                   score >= 15 kontrolu, DB'de <= 15 Medium. *@
                <span class="@AuditView.ItemRiskBadgeClass(Model.Input.Probability * Model.Input.Impact)"
                      data-argus-risk-rozet
                      data-esik-kotu="16"
                      data-esik-uyari="9"
                      data-sinif-kotu="@AuditView.ItemRiskBadgeClass(25)"
                      data-sinif-uyari="@AuditView.ItemRiskBadgeClass(12)"
                      data-sinif-iyi="@AuditView.ItemRiskBadgeClass(4)">
                    @Model.Input.Probability × @Model.Input.Impact = @(Model.Input.Probability * Model.Input.Impact)
                </span>
            </div>

            <div class="argus-filter-actions">
                <button class="solum-btn solum-btn-primary" type="submit">
                    @(duzenleniyor ? "Güncelle" : "Ekle")
                </button>
                @if (duzenleniyor)
                {
                    <a class="solum-btn" asp-page="/Audit/Items">Vazgeç</a>
                }
            </div>
        </form>
    </section>
</div>

@section Scripts {
    @* Risk onizlemesi yalniz bu ekrana ait — _Layout'a eklemek her sayfaya
       tasirdi (footprint-ladder). *@
    <script src="~/js/argus-item-risk.js" asp-append-version="true"></script>
}
