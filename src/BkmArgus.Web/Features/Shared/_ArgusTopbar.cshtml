@*
    Ust cubuk. Solum'un _SolumTopbar'i kullanilmiyor: sayfa basligi/alt basligi,
    bildirim cani ve BkmArgus cikis akisi (/Account/Logout) icin yuva yok.
    Gorunum solum.css siniflarindan gelir; ozel olanlar argus-theme.css'te.

    Mobil menu dugmesi Solum'un solum.js'ine baglidir (data-solum-menu-toggle) —
    eski kabuktaki AYRI mobil bagalanti satiri (12 kopya anchor) bu yuzden
    kaldirildi; artik cekmece ayni menuyu gosteriyor.
*@
@{
    var tamAd = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? string.Empty;
    var basHarfler = string.Join("", tamAd
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(k => k[0])).ToUpperInvariant();
    var rolEtiketi = BkmArgus.Web.Features.RoleLabel.For(
        User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value);
}
<header class="solum-topbar">
    <button type="button" class="solum-btn" data-solum-menu-toggle aria-label="Menüyü aç/kapat">☰</button>

    <div>
        <div class="argus-page-title">@ViewData["Title"]</div>
        @if (ViewData["Subtitle"] is string altBaslik && !string.IsNullOrEmpty(altBaslik))
        {
            <div class="argus-page-subtitle">@altBaslik</div>
        }
    </div>

    <span class="solum-spacer"></span>

    @* Kurulum dugmesi: tarayici "kurulabilir" diyene kadar GIZLI durur.
       Gorunurlugu argus-pwa.js `beforeinstallprompt` olayinda veriyor —
       yakalanmazsa dugme hic gorunmez (calismayan dugme gostermeyiz). *@
    <button type="button" class="solum-btn argus-install" data-argus-install hidden>
        Uygulamayı yükle
    </button>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <partial name="_ArgusNotifications" />

        <div class="argus-user">
            <span class="argus-user-initials">@basHarfler</span>
            <span>
                <span class="argus-user-name argus-stack">@tamAd</span>
                <span class="argus-user-role argus-stack">@rolEtiketi</span>
            </span>
        </div>

        @* Mobilde metin gizlenir, ikon kalir. `aria-label` HER ZAMAN duruyor:
           metni gizleyip erisilebilir ad birakmamak, ekran okuyucuda ADSIZ
           dugme uretirdi (olcum: 375px'te bu dugme 37px tasiyordu). *@
        <a class="solum-btn" asp-page="/Account/Logout" aria-label="Çıkış">
            <svg class="argus-ico" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"
                      stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="argus-logout-text">Çıkış</span>
        </a>
    }
    else
    {
        <a class="solum-btn solum-btn-primary" asp-page="/Account/Login">Giriş Yap</a>
    }
</header>
