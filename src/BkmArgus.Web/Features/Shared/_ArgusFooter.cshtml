@inject BkmArgus.Web.Data.SqlDb Db
@inject IWebHostEnvironment Env
@*
    Alt bilgi. Eski kabukta bu bilgiler koyu yan menunun dibindeydi; Solum
    kabugunda yan menunun alt yuvasi olmadigi icin alt bilgiye tasindi
    (bilgi kaybi yok, yer degisti).
*@
@{
    // GUVENLIK: durum bilgisi yalniz KIMLIGI DOGRULANMIS kullaniciya. Onceki hali
    // ortam kosuluna bagliydi, kimlige degil — anonim ziyaretci hem "baglanti
    // var/yok" teyidi aliyor hem her istekte bir DB baglanti denemesi tetikliyordu
    // (guvenlik denetimi 2026-08-25, plan 04 Faz 4).
    // Gelistirmede sunucu/veritabani adi da gosterilir; uretimde yalniz var/yok
    // (security-principles.md §7).
    var oturumVar = User.Identity?.IsAuthenticated == true;
    BkmArgus.Web.Data.SqlDb.DbInfo? dbBilgi = null;
    bool? dbAcik = null;

    if (oturumVar)
    {
        if (Env.IsDevelopment())
        {
            dbBilgi = await Db.GetDbInfoAsync();
            dbAcik = dbBilgi is not null;
        }
        else
        {
            dbAcik = await Db.CanConnectAsync();
        }
    }
}
<footer class="solum-footer">
    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:16px">
        <span>BKM Denetim — Risk İzleme</span>
        @if (dbAcik is bool acik)
        {
            <span class="argus-status">
                <span class="argus-status-dot @(acik ? "argus-status-ok" : "argus-status-down")"></span>
                <span>@(acik ? "Bağlantı OK" : "Bağlantı yok")</span>
            </span>
        }
        @if (Env.IsDevelopment() && dbBilgi is not null)
        {
            <span>DB: @dbBilgi.ServerName / @dbBilgi.DbName</span>
        }
        <span class="solum-spacer"></span>
        <span>Sürüm 1.0.0</span>
    </div>
</footer>
