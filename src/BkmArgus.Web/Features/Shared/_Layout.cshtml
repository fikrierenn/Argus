@*
    Kabuk. Yapi ve gorunum Solum'dan gelir (solum.css grid + solum.js mobil
    cekmece); parcalar ayri dosyalarda — birini degistirmek bu dosyayi
    degistirmeyi gerektirmez (plan: 04, Faz 2).

    data-solum-theme="light": Solum'un koyu tema blogu ":root:not([data-solum-theme=light])"
    seciciyle daha yuksek ozgullukte oldugu icin, isaretlenmezse isletim
    sistemi koyu modda BKM paletini EZIYOR. Panel tek gorunum kullanir.
*@
<!DOCTYPE html>
<html lang="tr" data-solum-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BKMKitap Denetim</title>

    @* PWA. Servis calisani YALNIZ statik varlik onbellekliyor; HTML ve
       /api/* asla — gerekcesi wwwroot/sw.js basindaki kutuda (plan 07 Faz 5).
       `asp-append-version` manifest'e KONMAZ: tarayici manifest adresini
       kimlik olarak tutar, her yayinda degisen sorgu dizesi kurulu
       uygulamayi ayri bir uygulama gibi gostermeye baslar. *@
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#e30622" />
    <meta name="application-name" content="Argus" />
    @* iOS manifest ikonlarini kullanmaz, kendi etiketini ister. *@
    <link rel="apple-touch-icon" href="~/icons/argus-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Argus" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    @* Sira onemli: solum.css once, argus-theme.css sonra (degisken ezmesi). *@
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Solum.Web/solum.css" />
    <link rel="stylesheet" href="~/css/argus-theme.css" asp-append-version="true" />
    @* Donusturulmemis ekranlar hala Tailwind yardimci siniflarini kullaniyor.
       SIRA: CDN once, config SONRA. tailwind.config.js global "tailwind" nesnesine
       atama yapiyor; CDN'den once yuklenirse "tailwind is not defined" ile patlar ve
       ozel renkler (bkm-red vb.) hic uygulanmaz. Eski kabukta ters sirada oldugu
       icin config oludur; renkler app.css'teki elle yazilmis siniflardan geliyordu. *@
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="~/js/tailwind.config.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
@* `data-solum-shell` ZORUNLU: solum.js kabugu artik bu NITELIKLE ariyor
   (eskiden getElementById("solum-shell")). Yoksa mobil menu acilmiyor ve
   Solum kendi gorunur uyarisini basiyor: "kabuk betigi yuklenmedi".
   Besinci kirici degisiklik — 2026-09-22'de ekran goruntusunden yakalandi. *@
<div class="solum-shell" id="solum-shell" data-solum-shell>
    <partial name="_ArgusSidebar" />
    <partial name="_ArgusTopbar" />

    <main class="solum-main">
        @* Mesaj anahtarlari BkmArgus sozlesmesi: StatusMessage / Error (razor-conventions.md).
           Solum'un _SolumAlerts parcasi SolumSuccess / SolumError okur — uyusmadigi icin
           kullanilmiyor; sinif adlari yine Solum'dan. *@
        @if (TempData["StatusMessage"] is string basariliMesaj)
        {
            <div class="solum-alert solum-alert-good" role="status">@basariliMesaj</div>
        }
        @if (TempData["Error"] is string hataMesaji)
        {
            <div class="solum-alert solum-alert-bad" role="alert">@hataMesaji</div>
        }

        @RenderBody()
    </main>

    <partial name="_ArgusFooter" />
</div>

@* Bildirim seridi: aria-live ile ekran okuyucuya da duyurulur.
   BURADA (kabukta) duruyor cunku argus-shell.js her sayfada yuklu; eskiden
   yalniz DOF panosunda tanimliydi ve diger ekranlarda bildir() alert()'e
   dusuyordu (denetim bulgusu 4.2b). *@
<div id="argusToast" class="argus-toast" role="status" aria-live="polite" hidden></div>

@* CSRF token'i: `/api/*` cagrilari bunu RequestVerificationToken basligiyla
   gonderiyor (plan 06 Faz 4). Form icinde degil cunku istek fetch ile gidiyor;
   Razor'un urettigi gizli alan JS icin tek okuma noktasi. *@
@Html.AntiForgeryToken()

<script src="~/_content/Solum.Web/solum.js"></script>
<script src="~/js/argus-shell.js" asp-append-version="true"></script>
@* Tablo hucrelerine etiket yazar (dar ekranda kart duzeni). Solum `<td>`ye
   `data-solum-label` basmaya baslayinca BU SATIR VE DOSYA SILINIR. *@
<script src="~/js/argus-table-mobile.js" asp-append-version="true"></script>
<script src="~/js/argus-pwa.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
