@*
    Kabuk. Yapi ve gorunum Solum'dan gelir (solum.css grid + solum.js mobil
    cekmece); parcalar ayri dosyalarda — birini degistirmek bu dosyayi
    degistirmeyi gerektirmez (plan: 04, Faz 2).

    data-solum-theme="light": Solum'un koyu tema blogu ":root:not([data-solum-theme=light])"
    seciciyle daha yuksek ozgullukte oldugu icin, isaretlenmezse isletim
    sistemi koyu modda BKM paletini EZIYOR. Panel tek gorunum kullanir.
*@
<!DOCTYPE html>
<html lang="tr" data-solum-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BKMKitap Denetim</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    @* Sira onemli: solum.css once, argus-theme.css sonra (degisken ezmesi). *@
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Solum.Web/solum.css" />
    <link rel="stylesheet" href="~/css/argus-theme.css" asp-append-version="true" />
    @* Donusturulmemis ekranlar hala Tailwind yardimci siniflarini kullaniyor.
       SIRA: CDN once, config SONRA. tailwind.config.js global "tailwind" nesnesine
       atama yapiyor; CDN'den once yuklenirse "tailwind is not defined" ile patlar ve
       ozel renkler (bkm-red vb.) hic uygulanmaz. Eski kabukta ters sirada oldugu
       icin config oludur; renkler app.css'teki elle yazilmis siniflardan geliyordu. *@
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="~/js/tailwind.config.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
<div class="solum-shell" id="solum-shell">
    <partial name="_ArgusSidebar" />
    <partial name="_ArgusTopbar" />

    <main class="solum-main">
        @* Mesaj anahtarlari BkmArgus sozlesmesi: StatusMessage / Error (razor-conventions.md).
           Solum'un _SolumAlerts parcasi SolumSuccess / SolumError okur — uyusmadigi icin
           kullanilmiyor; sinif adlari yine Solum'dan. *@
        @if (TempData["StatusMessage"] is string basariliMesaj)
        {
            <div class="solum-alert solum-alert-good" role="status">@basariliMesaj</div>
        }
        @if (TempData["Error"] is string hataMesaji)
        {
            <div class="solum-alert solum-alert-bad" role="alert">@hataMesaji</div>
        }

        @RenderBody()
    </main>

    <partial name="_ArgusFooter" />
</div>

<script src="~/_content/Solum.Web/solum.js"></script>
<script src="~/js/argus-shell.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
