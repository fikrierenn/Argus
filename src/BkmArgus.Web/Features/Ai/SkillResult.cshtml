@page
@model SkillResultModel
@attribute [Authorize(Policy = Policies.YonetimVeUstu)]
@{
    ViewData["Title"] = "Skill Sonucu";
    ViewData["Subtitle"] = "AI skill cikti detaylari";

    string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToString("yyyy-MM-dd HH:mm") : "-";

    string StatusBadgeClass(string status) => status switch
    {
        "DONE" => "bg-emerald-100 text-emerald-700",
        "ERROR" => "bg-rose-100 text-rose-700",
        "RUNNING" => "bg-amber-100 text-amber-700",
        _ => "bg-slate-100 text-slate-700"
    };

    string ConfidenceBadgeClass(int? score) => score switch
    {
        >= 80 => "bg-emerald-100 text-emerald-700",
        >= 50 => "bg-amber-100 text-amber-700",
        _ => "bg-rose-100 text-rose-700"
    };
}

<div class="flex items-center justify-between">
    <div class="text-sm font-semibold">Skill Sonucu #@Model.Execution?.ExecutionId</div>
    <a class="rounded-full border border-slate-200 px-3 py-1 text-xs text-slate-600" asp-page="/Ai/Index">Geri</a>
</div>

<div class="mt-4 grid gap-4 lg:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white p-4">
        <div class="text-xs uppercase text-slate-400">Skill</div>
        <div class="mt-2 text-sm font-semibold">@Model.Execution?.SkillId</div>
        <div class="mt-3 text-xs text-slate-500">Varlik Tipi</div>
        <div class="text-sm">@Model.Execution?.EntityType</div>
        <div class="mt-3 text-xs text-slate-500">Varlik ID</div>
        <div class="text-sm">@Model.Execution?.EntityId</div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4">
        <div class="text-xs uppercase text-slate-400">Durum</div>
        <div class="mt-2">
            <span class="inline-block rounded-full px-3 py-1 text-xs font-semibold @StatusBadgeClass(Model.Execution?.Status ?? "")">
                @Model.Execution?.Status
            </span>
        </div>
        <div class="mt-3 text-xs text-slate-500">Model</div>
        <div class="text-sm">@(Model.Execution?.ModelName ?? "-")</div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4">
        <div class="text-xs uppercase text-slate-400">Guven Skoru</div>
        <div class="mt-2">
            @if (Model.Execution?.ConfidenceScore.HasValue == true)
            {
                <span class="inline-block rounded-full px-3 py-1 text-xs font-semibold @ConfidenceBadgeClass(Model.Execution.ConfidenceScore)">
                    @Model.Execution.ConfidenceScore / 100
                </span>
            }
            else
            {
                <span class="text-sm text-slate-500">-</span>
            }
        </div>
        <div class="mt-3 text-xs text-slate-500">Olusturma</div>
        <div class="text-sm">@FormatDate(Model.Execution?.CreatedAt)</div>
        <div class="mt-3 text-xs text-slate-500">Tamamlanma</div>
        <div class="text-sm">@FormatDate(Model.Execution?.CompletedAt)</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Execution?.ErrorMessage))
{
    <div class="mt-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-2 text-sm text-rose-700">
        @Model.Execution.ErrorMessage
    </div>
}

<div class="mt-4 rounded-xl border border-slate-200 bg-white p-5">
    <div class="text-sm font-semibold">Cikti</div>
    <pre class="mt-3 whitespace-pre-wrap rounded-lg border border-slate-200 bg-slate-50 p-3 text-xs text-slate-700">@Model.OutputFormatted</pre>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Execution?.InputJson))
{
    <div class="mt-4 rounded-xl border border-slate-200 bg-white p-5">
        <div class="text-sm font-semibold">Girdi</div>
        <pre class="mt-3 whitespace-pre-wrap rounded-lg border border-slate-200 bg-slate-50 p-3 text-xs text-slate-700">@Model.Execution.InputJson</pre>
    </div>
}

<!-- Feedback Section -->
<div class="mt-4 rounded-xl border border-slate-200 bg-white p-5" id="feedback-section">
    <div class="text-sm font-semibold">Geri Bildirim</div>
    <div class="mt-3 flex items-center gap-3" id="feedback-buttons">
        <button onclick="submitFeedback(true)" class="rounded-lg border border-emerald-300 bg-emerald-50 px-4 py-2 text-sm text-emerald-700 hover:bg-emerald-100 transition">
            Faydali
        </button>
        <button onclick="submitFeedback(false)" class="rounded-lg border border-rose-300 bg-rose-50 px-4 py-2 text-sm text-rose-700 hover:bg-rose-100 transition">
            Faydali Degil
        </button>
    </div>
    <div id="feedback-sent" class="hidden mt-3 text-sm text-emerald-600">
        Geri bildiriminiz kaydedildi.
    </div>
</div>

@section Scripts {
<script>
    async function submitFeedback(isApproved) {
        try {
            const res = await fetch('/api/ai/feedback', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    skillExecutionId: @(Model.Execution?.ExecutionId ?? 0),
                    isApproved: isApproved,
                    rating: isApproved ? 5 : 1,
                    comment: null,
                    requestId: null
                })
            });
            if (res.ok) {
                document.getElementById('feedback-buttons').classList.add('hidden');
                document.getElementById('feedback-sent').classList.remove('hidden');
            }
        } catch (e) {
            console.error('Feedback error:', e);
        }
    }
</script>
}
