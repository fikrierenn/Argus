@page "{id:int?}"
@model UrunModel
@using Solum.Web.Components
@inject IKpiRenderer KpiRenderer
@* GUVENLIK: bu sayfa yetki kapisi OLMADAN duruyordu — anonim istek risk skoru,
   stok, iade orani, AI ozeti ve DOF sorumlusunu donduruyordu (guvenlik denetimi
   2026-08-25, plan 04 Faz 4). Dashboard satir-tiklama hedefi burasi. *@
@attribute [Authorize]
@*
    Urun detay. Solum ilkelleri: .solum-card · .solum-row · SolumTable · KpiCard ·
    _SolumEmpty · solum-badge (plan: 05, Dalga 1). Elle yazilmis 3 Tailwind kart
    kabi, 9 kolonlu elle tablo ve 2 sinif-uretici fonksiyon kaldirildi.
    Sekme seridi yerel (.argus-tabs) — Solum ikinci tuketicide devralacak, adlar
    o yuzden solum- sozlesmesine uyumlu tutuldu.
*@
@{
    ViewData["Title"] = "Ürün Detay";
    ViewData["Subtitle"] = "Kanıt odası ve DÖF aksiyonu";

    // Uc olcum kutucugu: stok / iade / son hareket. Ton verilmiyor — bunlar
    // ham olcum, iyi-kotu yargisi SP'den gelmiyor (uydurma yapilmaz).
    var olcumler = new List<KpiCard>
    {
        new() { Label = "Stok", Value = Model.StokMiktarText, Hint = Model.StokNot },
        new() { Label = "İade oranı", Value = Model.IadeOranText, Hint = Model.IadeNot },
        new() { Label = "Son hareket", Value = Model.SonHareketGunText, Hint = Model.SonHareketTip }
    };
}

<section class="solum-card">
    <div class="solum-card-head">
        <div>
            <div class="solum-card-sub">@Model.Mekan</div>
            <h3 class="solum-card-title">@Model.UrunAd</h3>
            <div class="solum-card-sub">@Model.UrunKod · @Model.Donem · StokId @Model.UrunId · Kategori3: @Model.Kategori3</div>
        </div>
        <div class="solum-row-side">
            <span class="@UrunView.SeviyeBadgeClass(Model.SkorSeviye)">@Model.Skor · @Model.SkorSeviye</span>
            <a class="solum-btn solum-btn-primary" asp-page="/Dof/Create" asp-route-urunId="@Model.UrunId" asp-route-mekanId="@Model.MekanId">DÖF başlat</a>
        </div>
    </div>
</section>

<div class="argus-split">
    <section class="solum-card">
        <div class="solum-card-head">
            <div>
                <h3 class="solum-card-title">AI özeti</h3>
                <div class="solum-card-sub">Otomatik yorum ve hipotez</div>
            </div>
            @if (Model.AiIstekId.HasValue)
            {
                <div class="solum-row-side">
                    <a class="solum-btn" asp-page="/Ai/Detay" asp-route-id="@Model.AiIstekId.Value">AI detayını gör</a>
                </div>
            }
        </div>
        @if (string.IsNullOrWhiteSpace(Model.AiOzet))
        {
            <partial name="/Pages/Shared/_SolumEmpty.cshtml"
                     model="@(("AI özeti yok.", (string?)"Bu ürün için AI analizi çalıştırılmamış."))" />
        }
        else
        {
            <div class="solum-row">
                <div class="solum-row-main">
                    <div class="solum-row-desc">@Model.AiOzet</div>
                </div>
            </div>
        }
        @KpiRenderer.RenderGrid(olcumler)
    </section>

    <section class="solum-card">
        <div class="solum-card-head">
            <div>
                <h3 class="solum-card-title">Özet bilgiler</h3>
                <div class="solum-card-sub">Risk skoru etkileri</div>
            </div>
        </div>
        <div class="solum-row">
            <div class="solum-row-main"><div class="solum-row-desc">Kritik bayrak</div></div>
            <div class="solum-row-side"><span class="solum-row-label">@Model.KritikFlag</span></div>
        </div>
        <div class="solum-row">
            <div class="solum-row-main"><div class="solum-row-desc">DÖF durumu</div></div>
            <div class="solum-row-side"><span class="solum-row-label">@Model.DofDurum</span></div>
        </div>
        <div class="solum-row">
            <div class="solum-row-main"><div class="solum-row-desc">Sorumlu</div></div>
            <div class="solum-row-side"><span class="solum-row-label">@Model.DofSorumlu</span></div>
        </div>
    </section>
</div>

<section class="solum-card">
    <nav class="argus-tabs" aria-label="Ürün detay sekmeleri">
        <a class="argus-tabs-item @(Model.ActiveTab == "risk" ? "argus-tabs-item--active" : "")"
           asp-page="/Urun/Index" asp-route-id="@Model.UrunId" asp-route-tab="risk">Risk analizi</a>
        <a class="argus-tabs-item @(Model.ActiveTab == "hareket" ? "argus-tabs-item--active" : "")"
           asp-page="/Urun/Index" asp-route-id="@Model.UrunId" asp-route-tab="hareket">Hareket geçmişi</a>
        <a class="argus-tabs-item @(Model.ActiveTab == "dof" ? "argus-tabs-item--active" : "")"
           asp-page="/Urun/Index" asp-route-id="@Model.UrunId" asp-route-tab="dof">DÖF geçmişi</a>
    </nav>

    @if (Model.ActiveTab == "risk")
    {
        @if (Model.Flaglar.Count == 0)
        {
            <partial name="/Pages/Shared/_SolumEmpty.cshtml"
                     model="@(("Risk bayrağı yok.", (string?)"Bu ürün seçili dönemde bayrak üretmemiş."))" />
        }
        else
        {
            @foreach (var bayrak in Model.Flaglar)
            {
                <div class="solum-row">
                    <div class="solum-row-main">
                        <div class="solum-row-label">@bayrak.Flag</div>
                        <div class="solum-row-desc">@bayrak.Aciklama</div>
                    </div>
                    <div class="solum-row-side">
                        <span class="@UrunView.EtkiBadgeClass(bayrak.Etki)">+@bayrak.Etki puan</span>
                    </div>
                </div>
            }
        }
    }
    else if (Model.ActiveTab == "hareket")
    {
        @Html.SolumTable(UrunView.HareketTable(Model.Hareketler))
    }
    else
    {
        @if (Model.Doflar.Count == 0)
        {
            <partial name="/Pages/Shared/_SolumEmpty.cshtml"
                     model="@(("DÖF kaydı yok.", (string?)"Bu ürün için açılmış düzeltici faaliyet bulunmuyor."))" />
        }
        else
        {
            @foreach (var dof in Model.Doflar)
            {
                <div class="solum-row">
                    <div class="solum-row-main">
                        <div class="solum-row-label">@dof.Baslik</div>
                        <div class="solum-row-desc">Sorumlu: @dof.Sorumlu</div>
                    </div>
                    <div class="solum-row-side">
                        <span class="solum-badge">@dof.Durum</span>
                        <span class="solum-row-desc">@dof.Tarih</span>
                    </div>
                </div>
            }
        }
    }
</section>
