@page
@model BkmArgus.Web.Features.Correlation.IndexModel
@attribute [Authorize(Policy = Policies.YonetimVeUstu)]
@using Solum.Web.Components
@using BkmArgus.Web.Features.Correlation
@inject IKpiRenderer KpiRenderer
@*
    Çapraz korelasyon. Solum ilkelleri: KpiCard · .solum-card · SolumTable ·
    solum-badge · _SolumEmpty (plan: 05, Dalga 1). Kaldırılanlar: 4 Tailwind kart
    kabı · 8 kolonlu elle yazılmış tablo · 7 sınıf-üretici Razor fonksiyonu.
    Kadran süzgeci sekme şeridine döndü (.argus-tabs, yerel).

    ÖNEMLİ AYRIM KORUNDU: risk skorunda YÜKSEK kötü, uyum oranında YÜKSEK iyi.
    Eski ekranda iki ayrı fonksiyon vardı; tek fonksiyona indirmek yarısını
    ters renkte gösterirdi (CorrelationView'da iki ayrı eşleme).
*@
@{
    ViewData["Title"] = "Çapraz Korelasyon";
    ViewData["Subtitle"] = "ERP riski × saha denetimi";

    var kartlar = new List<KpiCard>
    {
        new()
        {
            Label = "Toplam mekan",
            Value = Model.Summary.Total.ToString(),
            Hint = "ERP veya denetim verisi olan"
        },
        new()
        {
            Label = "Acil müdahale",
            Value = Model.Summary.UrgentCount.ToString(),
            // Is kurali: acil kadranda tek mekan bile varsa bu kotu bir durumdur.
            Tone = Model.Summary.UrgentCount > 0 ? KpiTone.Bad : KpiTone.Good,
            Hint = "İki kanal birden yüksek"
        },
        new()
        {
            Label = "Ortalama skor",
            Value = Model.Summary.AvgCombinedScore.ToString("0.0"),
            Hint = "Birleşik risk skoru"
        }
    };

    // Kadran süzgeci: boş değer "tümü" demek.
    (string Deger, string Etiket)[] kadranlar =
    [
        ("", "Tümü"),
        ("YUKSEK_YUKSEK", "Acil"),
        ("YUKSEK_DUSUK", "ERP riskli"),
        ("DUSUK_YUKSEK", "Saha riskli"),
        ("DUSUK_DUSUK", "Düşük risk")
    ];
}

@KpiRenderer.RenderGrid(kartlar)

<section class="solum-card">
    <div class="solum-card-head">
        <nav class="argus-tabs" aria-label="Kadran süzgeci">
            @foreach (var (deger, etiket) in kadranlar)
            {
                var aktif = string.Equals(Model.Quadrant ?? "", deger, StringComparison.OrdinalIgnoreCase);
                <a class="argus-tabs-item @(aktif ? "argus-tabs-item--active" : "")"
                   asp-page="/Correlation/Index"
                   asp-route-quadrant="@(deger.Length == 0 ? null : deger)">@etiket</a>
            }
        </nav>
        <div class="solum-row-side">
            @* Hesaplama tetikleyici: POST, antiforgery token'ı Razor Pages üretir. *@
            <form method="post" asp-page-handler="Recalculate">
                <button type="submit" class="solum-btn">Yeniden hesapla</button>
            </form>
        </div>
    </div>

    @Html.SolumTable(CorrelationView.Table(Model.Items))
</section>

@if (Model.Items.Count > 0)
{
    <section class="solum-card">
        <div class="solum-card-head">
            <div>
                <h3 class="solum-card-title">Kadran dağılımı</h3>
                <div class="solum-card-sub">Hangi mekan hangi kanalda riskli — satıra tıklayın</div>
            </div>
        </div>
        @foreach (var oge in Model.Items.Take(10))
        {
            <a class="solum-row argus-row-link" href="/Risk?mekan=@oge.LocationId">
                <span class="solum-row-main">
                    <span class="solum-row-label">@oge.LocationName</span>
                    <span class="solum-row-desc">
                        ERP @oge.ErpRiskScore.ToString("0.0") · uyum %@oge.AuditComplianceRate.ToString("0.0") ·
                        @oge.AuditCount denetim
                    </span>
                </span>
                <span class="solum-row-side">
                    <span class="@CorrelationView.RiskBadgeClass(oge.CombinedScore)">@oge.CombinedScore.ToString("0.0")</span>
                    <span class="@CorrelationView.QuadrantBadgeClass(oge.Quadrant)">@CorrelationView.QuadrantLabel(oge.Quadrant)</span>
                </span>
            </a>
        }
    </section>
}
